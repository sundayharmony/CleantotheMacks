# Database (see README for local vs production)
DATABASE_URL="file:./dev.db"

# Resend — https://resend.com (transactional email)
RESEND_API_KEY=

# Must be an address on a domain you verified in Resend (Domains → Add → DNS records → Verify).
# Until verified, Resend returns 550 and mail will bounce.
EMAIL_FROM="Clean to the Macks <booking@cleantothemacks.com>"

# Where new booking requests and other admin notifications are sent
ADMIN_EMAIL=your-inbox@example.com

# Optional: Reply-To on the client’s “request received” email (defaults to ADMIN_EMAIL)
# BOOKING_REPLY_TO=hello@cleantothemacks.com
