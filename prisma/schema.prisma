generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  address   String
  homeSize  String
  notes     String?
}
